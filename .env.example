# Copy to .env and adjust as needed: cp .env.example .env
# Read by Docker Compose and by Django (via python-dotenv) when running locally.

DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True

POSTGRES_DB=snippet_saver
POSTGRES_USER=snippet_saver
POSTGRES_PASSWORD=snippet_saver
POSTGRES_HOST=localhost
# Host port the Compose Postgres container is published on.
POSTGRES_PORT=5433
